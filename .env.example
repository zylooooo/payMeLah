BOT_API_TOKEN=your_bot_api_token_here
BOT_NAME=your_bot_name_here
LOG_LEVEL=INFO
ENV=dev

# Database configuration
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5432
# Alembic auto migration
AUTO_MIGRATE=true
# For local dev with docker-compose: postgresql+asyncpg://user:pass@postgres/dbname
# For Neon (production): postgresql+asyncpg://user:pass@host.neon.tech/dbname?sslmode=require
DB_URL=your_database_connection_string

# Webhook mode (production only - Render/hosted deployment)
# Leave WEBHOOK_URL empty to use polling mode (default for local dev)
# Set to the full webhook URL when deploying, e.g. https://your-app.onrender.com/webhook
WEBHOOK_URL=your_render_webhook_url_here
# PORT is provided automatically by Render (10000). For local webhook testing, use 8443.
PORT=your_render_port_here